<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  WeMessage.app, the Swift host (v2 S2d). tools/swift/bundle.sh copies this
  file into Contents/ and patches both version keys from the root
  package.json, so the 0.0.0 below is a placeholder and never ships.

  The Automation prompt, the copyright and the category are the strings the
  v1 desktop app shipped. Since v2 S6a test/release/pack-swift.spec.ts pins
  them as literals, and v2 S6c deleted that app.

  No LSUIElement: the host has no UI in this slice and is launched by launchd
  in daemon mode, so there is no Dock icon to hide. No CFBundleURLTypes: the
  wemessage URL scheme was the v1 desktop app's and is not claimed here.

  The Contacts prompt (S4g) is D-UI-9's copy, ProvisionalUI.contactsUsage,
  and pack-swift.spec.ts holds the two equal. The app asks for Contacts only
  when the user opens a thread (D-UI-54), never at launch.
-->
<plist version="1.0">
  <dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleExecutable</key>
    <string>WeMessage</string>
    <key>CFBundleIconFile</key>
    <string>AppIcon</string>
    <key>CFBundleIdentifier</key>
    <string>sh.wemessage.gateway</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>WeMessage</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>0.0.0</string>
    <key>CFBundleVersion</key>
    <string>0.0.0</string>
    <key>LSApplicationCategoryType</key>
    <string>public.app-category.productivity</string>
    <key>LSMinimumSystemVersion</key>
    <string>26.0</string>
    <key>NSAppleEventsUsageDescription</key>
    <string>WeMessage sends replies through Messages on your behalf, and only ones you have approved.</string>
    <key>NSContactsUsageDescription</key>
    <string>WeMessage shows the names and photos from your Contacts next to messages. Nothing is uploaded. You can say no; initials are shown instead.</string>
    <key>NSHumanReadableCopyright</key>
    <string>Copyright © 2026 the WeMessage authors</string>
  </dict>
</plist>
