<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The bundled Node's entitlements under the hardened runtime: four.

  allow-jit and allow-unsigned-executable-memory: V8 compiles JavaScript at
  run time, and without them the daemon dies at its first function call.

  disable-library-validation: node loads the better-sqlite3 addon, and a
  self-signed leaf has no Team ID for library validation to match the addon
  against. This is the trade the Electron release lane avoids with a
  Developer ID; this lane has none.

  automation.apple-events: the daemon is the process that talks to Messages.

  Never here: the debugger-attach entitlement (a debugger could attach to the
  process that holds Full Disk Access) or the dyld environment entitlement
  (an environment variable could inject a library into it).
-->
<plist version="1.0">
  <dict>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <key>com.apple.security.automation.apple-events</key>
    <true/>
  </dict>
</plist>
