{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "type": "string",
      "enum": [
        "sol",
        "hermes",
        "luna",
        "openclaw",
        "echo",
        "generic"
      ]
    },
    "displayName": {
      "type": "string",
      "minLength": 1
    },
    "config": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    }
  },
  "required": [
    "id",
    "kind",
    "displayName"
  ],
  "additionalProperties": false
}
