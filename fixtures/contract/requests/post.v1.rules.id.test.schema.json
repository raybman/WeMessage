{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "text": {
      "type": [
        "string",
        "null"
      ]
    },
    "handle": {
      "type": "string",
      "minLength": 1
    },
    "isGroup": {
      "type": "boolean"
    },
    "kind": {
      "type": "string",
      "enum": [
        "text",
        "tapback",
        "edit",
        "unsend",
        "audio",
        "attachment-only"
      ]
    }
  },
  "required": [
    "text"
  ],
  "additionalProperties": false
}
