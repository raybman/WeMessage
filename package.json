{
  "name": "wemessage-monorepo",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . && prettier --check .",
    "dep:check": "depcruise packages apps fixtures --config .dependency-cruiser.cjs",
    "licenses:check": "license-checker-rseidelsohn --failOn 'GPL;AGPL;GPL-3.0;AGPL-3.0' && license-checker-rseidelsohn --start packages/adapter-testkit --failOn 'GPL;AGPL;GPL-3.0;AGPL-3.0'"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^3.2.0",
    "dependency-cruiser": "^17.0.0",
    "eslint": "^9.0.0",
    "license-checker-rseidelsohn": "^4.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.2.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  }
}
