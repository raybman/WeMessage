{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wemessage.dev/schemas/v1/event.json",
  "title": "event frame payload (wire v1)",
  "type": "object",
  "additionalProperties": false,
  "required": ["event"],
  "properties": {
    "event": {
      "type": "string",
      "enum": [
        "adapter.health",
        "arming.changed",
        "connection.state",
        "draft.approved",
        "draft.created",
        "draft.delta",
        "draft.expired",
        "draft.failed",
        "draft.recalled",
        "draft.redrafted",
        "draft.rejected",
        "draft.requeued",
        "draft.sent",
        "draft.superseded",
        "gate.denied",
        "gateway.disconnected",
        "message.edited",
        "message.received",
        "message.unsent",
        "rule.matched",
        "toggle.changed"
      ]
    },
    "message": {
      "type": "object"
    },
    "guid": {
      "type": "string"
    },
    "newText": {},
    "ruleId": {
      "type": "string"
    },
    "adapterId": {
      "type": "string"
    },
    "draft": {
      "type": "object"
    },
    "draftId": {
      "type": "string"
    },
    "byDraftId": {
      "type": "string"
    },
    "newDraftId": {
      "type": "string"
    },
    "actor": {
      "type": "object"
    },
    "batchId": {
      "type": "string"
    },
    "sentMessageGuid": {
      "type": "string"
    },
    "error": {
      "type": "object"
    },
    "reason": {
      "type": "string"
    },
    "chatGuid": {
      "type": "string"
    },
    "key": {
      "type": "string"
    },
    "value": {},
    "status": {
      "type": "string"
    },
    "state": {
      "type": "string"
    },
    "correlation": {
      "type": "object"
    },
    "seq": {
      "type": "number"
    },
    "textDelta": {
      "type": "string"
    },
    "armed": {
      "type": "boolean"
    },
    "until": {}
  }
}
