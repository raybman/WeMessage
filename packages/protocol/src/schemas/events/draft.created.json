{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wemessage.dev/schemas/v1/events/draft.created.json",
  "title": "draft.created event payload (wire v1)",
  "type": "object",
  "additionalProperties": false,
  "required": ["event", "draft"],
  "properties": {
    "event": {
      "type": "string",
      "const": "draft.created"
    },
    "draft": {
      "type": "object",
      "properties": {
        "clampedBy": {
          "type": "string",
          "enum": [
            "kill-switch",
            "disconnected",
            "read-only",
            "contact-denied",
            "group-auto-forbidden",
            "outside-window",
            "rate-limited",
            "circuit-open",
            "loop-detected",
            "unapproved",
            "adapter-disabled",
            "sms-auto-forbidden"
          ]
        }
      }
    }
  }
}
